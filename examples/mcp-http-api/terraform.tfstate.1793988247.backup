                "content": "{\"serverName\":\"bookings-mcp\",\"serverVersion\":\"1.0.0\",\"tools\":[{\"description\":\"List the signed-in user's bookings. Optionally filter by status.\",\"inputSchema\":{\"additionalProperties\":false,\"properties\":{\"status\":{\"description\":\"Filter bookings by status. Omit to return bookings of every status for the signed-in user.\",\"enum\":[\"confirmed\",\"cancelled\",\"past\"],\"type\":\"string\"}},\"required\":[],\"type\":\"object\"},\"name\":\"get_my_bookings\"}]}",
                "filename": "tools.json"
              }
            ],
